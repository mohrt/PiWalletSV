{
  "name": "@piwallet/companion",
  "version": "0.1.0-a0",
  "private": true,
  "description": "PiWalletSV companion PWA — pairing, proposals, broadcasting, and shared PW1 multipart QR framing (matches piwallet.qr.multipart on the Pi).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.8.0",
    "vite": "^7.3.3",
    "vitest": "~3.2.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/bip32": "^2.2.0",
    "cbor-x": "^1.6.4",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  }
}
