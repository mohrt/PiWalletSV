# Default docs/marketing host for cross-domain links rendered by the
# companion (footer, "Why is this safe?" links, terms-modal pointers,
# 404 page). Vite inlines `%VITE_DOCS_BASE_URL%` in index.html and
# `import.meta.env.VITE_DOCS_BASE_URL` in TS at *build* time.
#
# Defaults here are used by `npm run dev` and `npm run build` without
# overrides. publish.sh exports VITE_DOCS_BASE_URL=https://dev.piwalletsv.com
# when building the dev mirror, which wins over this file.
#
# Keep this file checked in: it's the canonical prod fallback.
VITE_DOCS_BASE_URL=https://piwalletsv.com
